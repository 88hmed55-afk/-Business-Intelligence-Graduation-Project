# ============================================================
# Nova BI - Business Intelligence Management System
# Copy to .env and adjust for your environment.
# ============================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# IMPORTANT: replace with a strong random secret in production
# e.g. openssl rand -hex 32
SECRET_KEY=CHANGE_ME_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Bootstrap credentials (seeded on first start) ---
ADMIN_EMAIL=admin@bisystem.dev
ADMIN_PASSWORD=Admin@1234
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bi
POSTGRES_PASSWORD=bi_password
POSTGRES_DB=bi_system

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Vercel (production) overrides ---
# Optional: set a single connection string (e.g. Neon, Upstash) as a Vercel
# environment variable instead of the individual *_HOST/*_PORT/*_USER/*_PASSWORD
# variables above. These are read from the real process environment.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# REDIS_URL=rediss://default:password@host:6379

# Optional: comma-separated CORS origins allowed to call the API directly.
# Not required when the frontend and API share the same Vercel domain
# (requests are same-origin and routed via vercel.json rewrites).
# BACKEND_CORS_ORIGINS=https://your-project.vercel.app

# --- Exposed host ports ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
